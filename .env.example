# AI Order Parser - PRODUCTION template. Copy to `.env` on the server and fill in.
# Generate secrets with: openssl rand -hex 32

APP_ENV=production
LOG_LEVEL=INFO
LOG_DIR=/app/logs

# --- API security (REQUIRED in production) ---
API_AUTH_TOKEN=paste-generated-secret-here
API_RATE_LIMIT_PER_MINUTE=60

# --- Local NuExtract AI extraction (REQUIRED - orders cannot parse without it) ---
# Ollama server as seen FROM INSIDE the app process/container. Local runs use
# http://127.0.0.1:11434; Docker containers reaching host-installed Ollama use
# http://host.docker.internal:11434 (needs extra_hosts host-gateway, see
# docker-compose.yml); a sibling Compose Ollama service uses http://ollama:11434.
# Production model (verified 2026-10-02): official Ollama-library "nuextract"
# (3.8B, Phi-3). The sroecker/nuextract-tiny-v1.5 port was evaluated and
# rejected (temperature-0 repeat loops + PII hallucination). Verify with:
#   ollama show nuextract
# and a live extraction test before going live.
OLLAMA_BASE_URL=http://host.docker.internal:11434
NUEXTRACT_MODEL=nuextract
NUEXTRACT_TIMEOUT_SECONDS=120
NUEXTRACT_MAX_ATTEMPTS=3
NUEXTRACT_RETRY_BACKOFF_SECONDS=1
NUEXTRACT_NUM_PREDICT=800
NUEXTRACT_NUM_CTX=4096
NUEXTRACT_MAX_INPUT_CHARS=8000

# --- Legacy Puter AI gateway (NOT used by the production extraction path) ---
# Kept only for VisionParser rollback. Do not set unless rolling back.
# PUTER_AUTH_TOKEN=paste-puter-token-here
# AI_TEXT_MODEL=gpt-4.1
# DEPRECATED: AI_VISION_MODEL (gpt-4o direct vision) no longer used; kept for rollback only.
# AI_VISION_MODEL=gpt-4o
AI_TIMEOUT_SECONDS=120

# --- Google Vision OCR (REQUIRED - only OCR provider for images/scanned PDFs) ---
# Key from https://console.cloud.google.com/apis/credentials (restrict to Vision API)
ENABLE_GOOGLE_VISION=true
GOOGLE_VISION_API_KEY=paste-google-vision-api-key-here
GOOGLE_VISION_BASE_URL=https://vision.googleapis.com
GOOGLE_VISION_TIMEOUT_SECONDS=30
GOOGLE_VISION_MAX_RETRIES=3
GOOGLE_VISION_BACKOFF_SECONDS=1.0

# --- Odoo (authoritative system; leave empty only if you want review-only mode) ---
ODOO_URL=http://your-odoo-host:8069
ODOO_DB=your-db
ODOO_USER=your-user
ODOO_PASSWORD=your-password

# --- Telegram (REQUIRED for Telegram orders) ---
TELEGRAM_BOT_TOKEN=paste-bot-token-from-BotFather
TELEGRAM_WEBHOOK_URL=https://yourdomain.com/telegram/webhook
TELEGRAM_WEBHOOK_SECRET=paste-generated-secret-here

# --- Email (optional; leave empty to disable polling) ---
EMAIL_IMAP_HOST=
EMAIL_IMAP_PORT=993
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_POLL_INTERVAL=60

# --- Production hardening (recommended ON) ---
ENABLE_IDEMPOTENCY=true
ENABLE_RETENTION_SWEEPER=true
SESSION_RETENTION_DAYS=30
WORKER_COUNT=3
QUEUE_MAX_SIZE=500
JOB_TIMEOUT_SECONDS=300
MAX_UPLOAD_MB=10
