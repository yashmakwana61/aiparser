# AI Order Parser - PRODUCTION template. Copy to `.env` on the server and fill in.
# Generate secrets with: openssl rand -hex 32

APP_ENV=production
LOG_LEVEL=INFO
LOG_DIR=/app/logs

# --- API security (REQUIRED in production) ---
API_AUTH_TOKEN=paste-generated-secret-here
API_RATE_LIMIT_PER_MINUTE=60

# --- Puter AI gateway (REQUIRED - text normalisation cannot run without it) ---
# Token from https://puter.com/dashboard (free tier uses /drivers/call).
# Text orders are normalized by the ChatGPT text model below; images and
# scanned PDFs are OCR'd by Google Vision first, then normalized the same way.
PUTER_AUTH_TOKEN=paste-puter-token-here
AI_TEXT_MODEL=gpt-4.1
# DEPRECATED: AI_VISION_MODEL (gpt-4o direct vision) no longer used; kept for rollback only.
# AI_VISION_MODEL=gpt-4o
AI_TIMEOUT_SECONDS=120
AI_MAX_ATTEMPTS=3
AI_RETRY_BACKOFF_SECONDS=2

# --- AI-assisted matching (LLM tiebreaker for ambiguous lines) ---
# Off by default. When on, one gpt-4.1-mini call per ambiguous order selects
# from bounded candidate sets (never invents). Picks at/above the threshold
# resolve deterministically; below it they only pre-rank pick buttons.
# Customers are only ever re-ranked, never auto-accepted by AI.
AI_MATCH_ENABLED=false
AI_MATCH_MODEL=gpt-4.1-mini
AI_MATCH_ATTEMPTS=2
AI_MATCH_MAX_CANDIDATES=8
AI_MATCH_AUTO_THRESHOLD=95

# --- Google Vision OCR (REQUIRED - only OCR provider for images/scanned PDFs) ---
# Key from https://console.cloud.google.com/apis/credentials (restrict to Vision API)
ENABLE_GOOGLE_VISION=true
GOOGLE_VISION_API_KEY=paste-google-vision-api-key-here
GOOGLE_VISION_BASE_URL=https://vision.googleapis.com
GOOGLE_VISION_TIMEOUT_SECONDS=30
GOOGLE_VISION_MAX_RETRIES=3
GOOGLE_VISION_BACKOFF_SECONDS=1.0

# --- Odoo (authoritative system; leave empty only if you want review-only mode) ---
ODOO_URL=http://your-odoo-host:8069
ODOO_DB=your-db
ODOO_USER=your-user
ODOO_PASSWORD=your-password

# --- Telegram (REQUIRED for Telegram orders) ---
TELEGRAM_BOT_TOKEN=paste-bot-token-from-BotFather
TELEGRAM_WEBHOOK_URL=https://yourdomain.com/telegram/webhook
TELEGRAM_WEBHOOK_SECRET=paste-generated-secret-here

# --- Email (optional; leave empty to disable polling) ---
EMAIL_IMAP_HOST=
EMAIL_IMAP_PORT=993
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_POLL_INTERVAL=60

# --- Master data resolution ---
# Known order collectors/vendors that must NEVER resolve as the customer
# (comma-separated, case-insensitive). When the extracted customer matches,
# resolution reroutes to the deliver-to party or routes to explicit review.
NEVER_CUSTOMER_NAMES=HOT CAKES PRIVATE LIMITED

# --- Production hardening (recommended ON) ---
ENABLE_IDEMPOTENCY=true
ENABLE_RETENTION_SWEEPER=true
SESSION_RETENTION_DAYS=30
WORKER_COUNT=3
QUEUE_MAX_SIZE=500
JOB_TIMEOUT_SECONDS=300
MAX_UPLOAD_MB=10
